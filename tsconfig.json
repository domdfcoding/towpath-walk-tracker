{
  "compilerOptions": {
    "outDir": "./towpath_walk_tracker/static/js",
    "allowJs": true,
    "target": "es2020",
    "module": "es2020",
    "types": ["leaflet", "leaflet-geometryutil", "leaflet-polylinedecorator", "leaflet.awesome-markers"],
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUmdGlobalAccess": true
  },
  "exclude": ["./src/core/*"],
  "include": [
    "./src/**/*.ts"
  ],
  "noEmit": true,
  "noEmitOnError": false
}
